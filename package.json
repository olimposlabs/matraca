{
  "name": "matraca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch server/start.ts",
    "dev:web": "vite --host 127.0.0.1",
    "db:start": "tsx scripts/db-start.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/start.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "lucide-react": "1.71.0",
    "mediabunny": "1.65.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
